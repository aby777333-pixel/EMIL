generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          String    @default("trader") // trader | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      TradingAccount[]
  consentLogs   ConsentLog[]
  auditLogs     AuditLog[]
  riskOverrides RiskOverride[]
  knowledgeItems KnowledgeItem[]
  selectedMarkets String? // comma list of Market.key; null/empty = all markets
  profile       CustomerProfile?
  apiKeys       ApiKey[]
  brokerLinks   UserBrokerConnection[]
  // Alert delivery (spec §37/§65)
  telegramChatId String?
  notifyTelegram Boolean   @default(false)
  notifyEmail    Boolean   @default(false)
  // Two-factor authentication (TOTP secret stored encrypted)
  totpSecret     String?
  totpEnabled    Boolean   @default(false)

  @@map("users")
}

// ============ COMMAND CENTER — CRM & B2B PLATFORM ============
// EMIL is sold to customers online; each customer connects their own broker
// APIs and can integrate programmatically through EMIL API keys.

model CustomerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("trial") // lead | trial | active | suspended | churned
  planKey     String    @default("trial")
  company     String?
  phone       String?
  country     String?
  tags        String?   // comma list
  mrr         Float     @default(0) // manual/derived monthly recurring revenue
  trialEndsAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  notes       CrmNote[]

  @@map("customer_profiles")
}

model CrmNote {
  id          String   @id @default(cuid())
  profileId   String
  profile     CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authorEmail String
  note        String
  createdAt   DateTime @default(now())

  @@map("crm_notes")
}

model BillingPlan {
  id           String  @id @default(cuid())
  key          String  @unique // trial | starter | pro | institutional
  name         String
  priceMonthly Float   @default(0)
  currency     String  @default("USD")
  features     String? // JSON array
  active       Boolean @default(true)
  sortOrder    Int     @default(100)

  @@map("billing_plans")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  prefix     String    // first characters shown in UIs; full key never stored
  keyHash    String    @unique // sha256 of the full key
  status     String    @default("active") // active | revoked
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  // Developer portal (platform round A): sandbox keys can never reach a live
  // venue; scopes gate endpoint families; IP allow-lists and expiry are
  // enforced on every request.
  environment String    @default("live") // live | sandbox
  scopes      String    @default("read") // csv of lib/entitlements SCOPES
  ipAllowlist String?   // csv of IPs / IP prefixes (e.g. 203.0.113.7, 10.0.)
  expiresAt   DateTime?
  usage       ApiUsage[]

  @@map("api_keys")
}

// Per-key, per-day, per-endpoint usage counters — the developer portal usage
// chart and the metered-billing input. Bumped atomically in one upsert.
model ApiUsage {
  id       String   @id @default(cuid())
  keyId    String
  key      ApiKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  userId   String
  day      String   // YYYY-MM-DD (UTC)
  endpoint String
  count    Int      @default(0)
  lastAt   DateTime @default(now())

  @@unique([keyId, day, endpoint])
  @@index([userId, day])
  @@map("api_usage")
}

// Outbound webhooks: EMIL → the customer's endpoint. Every delivery is
// HMAC-signed (X-EMIL-Signature) and retried with backoff; the customer sees
// the delivery log in the developer portal.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  userId         String
  url            String
  secret         String    // encrypted at rest; shown once at creation
  events         String    @default("*") // csv of lib/webhooks EVENTS, or *
  description    String?
  status         String    @default("active") // active | paused | failing
  failCount      Int       @default(0)
  lastDeliveryAt DateTime?
  lastStatusCode Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deliveries     WebhookDelivery[]

  @@index([userId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  userId        String
  event         String
  payload       String
  attempt       Int             @default(0)
  status        String          @default("pending") // pending | delivered | failed | dead
  responseCode  Int?
  responseBody  String?
  nextAttemptAt DateTime        @default(now())
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ============ BRING-YOUR-OWN DATA (customer feed) ============
// A business pushes its own quotes, orders and P&L through /api/v1/ingest.
// Rows are isolated per user and labelled CUSTOMER FEED wherever shown —
// never mixed with EMIL's research feeds, never an execution trigger.
model CustomerFeedQuote {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  bid       Float?
  ask       Float?
  last      Float?
  ts        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, symbol, ts])
  @@map("customer_feed_quotes")
}

model CustomerFeedOrder {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  symbol     String
  side       String
  qty        Float
  price      Float?
  status     String   @default("filled")
  account    String?
  ts         DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, ts])
  @@map("customer_feed_orders")
}

model CustomerFeedPnl {
  id         String   @id @default(cuid())
  userId     String
  account    String?
  equity     Float?
  balance    Float?
  realized   Float?
  unrealized Float?
  ts         DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, ts])
  @@map("customer_feed_pnl")
}

// ============ PLATFORM BRIDGES (trader inbound) ============
// A trader's own platform pushes into EMIL: the MT5/MT4 bridge EA streams
// account, positions and deals; TradingView (or any system) posts alerts to a
// per-connection webhook URL. Tokens are hashed; the plain token is shown once.
model BridgeConnection {
  id              String    @id @default(cuid())
  userId          String
  kind            String    // mt5 | mt4 | tradingview | generic
  label           String
  tokenHash       String    @unique
  tokenPrefix     String
  mode            String    @default("mirror") // mirror | alerts | journal | paper_copy
  status          String    @default("pending") // pending | connected | stale | error
  accountNumber   String?
  broker          String?
  server          String?
  currency        String?
  balance         Float?
  equity          Float?
  margin          Float?
  freeMargin      Float?
  floatingPnl     Float?
  leverage        Int?
  meta            String?   // JSON: { venue?, terminalBuild?, symbolsMap? }
  lastHeartbeatAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  positions       BridgePosition[]
  deals           BridgeDeal[]
  signals         BridgeSignal[]

  @@index([userId])
  @@map("bridge_connections")
}

model BridgePosition {
  id           String           @id @default(cuid())
  connectionId String
  connection   BridgeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  ticket       String
  symbol       String
  side         String   // buy | sell
  volume       Float
  entryPrice   Float?
  currentPrice Float?
  sl           Float?
  tp           Float?
  profit       Float?
  swap         Float?
  openedAt     DateTime?
  updatedAt    DateTime @default(now())

  @@unique([connectionId, ticket])
  @@index([userId])
  @@map("bridge_positions")
}

model BridgeDeal {
  id           String           @id @default(cuid())
  connectionId String
  connection   BridgeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  ticket       String
  symbol       String
  side         String
  volume       Float
  price        Float?
  profit       Float?
  commission   Float?
  swap         Float?
  ts           DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([connectionId, ticket])
  @@index([userId, ts])
  @@map("bridge_deals")
}

model BridgeSignal {
  id           String           @id @default(cuid())
  connectionId String
  connection   BridgeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  source       String   // tradingview | generic
  symbol       String?
  action       String?  // buy | sell | close | alert | journal
  price        Float?
  message      String
  handled      String?  // csv of what EMIL did: notified, journaled, paper_order:<id>, webhook
  result       String?
  receivedAt   DateTime @default(now())

  @@index([userId, receivedAt])
  @@map("bridge_signals")
}

// Public status page incidents (admin-managed).
model StatusIncident {
  id         String    @id @default(cuid())
  title      String
  body       String?
  severity   String    @default("minor") // minor | major | maintenance
  status     String    @default("investigating") // investigating | identified | monitoring | resolved
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@map("status_incidents")
}

// Modular global data-provider layer (EMIL Universe §230/§276): official APIs,
// public datasets and legitimate free tiers — never scraping. Every provider
// carries license notes, freshness, priority and a fallback so sources can be
// swapped without rebuilding EMIL. Research data, never execution data.
model DataProvider {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  category      String    // macro | market_data | fundamentals | fx | crypto | news | energy | agriculture | trade | weather | identifiers | regulatory
  baseUrl       String
  docsUrl       String
  authType      String    @default("none") // none | api_key
  apiKey        String?
  enabled       Boolean   @default(true)
  priority      Int       @default(100) // lower = preferred within its category
  fallbackKey   String?   // DataProvider.key to try when this one fails
  license       String?   // license / attribution / commercial-use notes
  freshness     String    @default("varies") // realtime | delayed | daily | eod | varies
  coverage      String?
  status        String    @default("unknown") // unknown | healthy | degraded | error | needs_key
  lastCheckedAt DateTime?
  lastLatencyMs Int?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("data_providers")
}

// Server-side research-feed cache — one upstream fetch per TTL regardless of
// user count, so free-tier rate limits (e.g. Twelve Data 8 credits/min) are
// respected. Research data only.
model CacheEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  payload   String
  fetchedAt DateTime @default(now())

  @@map("research_cache")
}

// Per-user market watchlist (spec §66). Symbols are Twelve Data notation.
// Named watchlists (spec §66) — several lists per user, a symbol may sit on
// more than one list, optional read-only public share link (/w/<token>).
model Watchlist {
  id         String          @id @default(cuid())
  userId     String
  name       String
  sortOrder  Int             @default(0)
  shareToken String?         @unique
  createdAt  DateTime        @default(now())
  items      WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String     @id @default(cuid())
  userId      String
  symbol      String
  label       String?
  watchlistId String?
  watchlist   Watchlist? @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([watchlistId, symbol])
  @@index([userId])
  @@map("watchlist_items")
}

// Per-customer broker/data-provider credentials. The rows in
// india_api_providers stay the catalog + the house/owner credentials; every
// non-admin customer links their own accounts here.
model UserBrokerConnection {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerKey   String    // india_api_providers.key
  apiKey        String?
  apiSecret     String?
  accessToken   String?
  clientCode    String?
  permissionTier String?  // read_only | analysis | trading — connect wizard (spec §6–7)
  consentVersion String?
  consentAt     DateTime?
  status        String    @default("configured") // configured | connected | error
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, providerKey])
  @@map("user_broker_connections")
}

// ============ GLOBAL MARKETS ============

model Market {
  id           String @id @default(cuid())
  key          String @unique // forex | metals | indices | energies | crypto | india | us_stocks | europe_stocks | asia_stocks
  name         String
  region       String
  exchanges    String // comma list, display only
  assetClasses String // comma list mapping to Instrument.assetClass
  description  String
  dataStatus   String @default("live") // live | coming_soon
  sortOrder    Int    @default(100)

  @@map("markets")
}

// ============ BROKERS & ACCOUNTS ============

model Broker {
  id          String   @id @default(cuid())
  name        String
  platform    String   // MT5 | MT4 | cTrader | FIX
  serverName  String?
  connections BrokerConnection[]
  accounts    TradingAccount[]

  @@map("brokers")
}

model BrokerConnection {
  id             String   @id @default(cuid())
  brokerId       String
  broker         Broker   @relation(fields: [brokerId], references: [id])
  status         String   @default("connected") // connected | degraded | disconnected
  latencyMs      Int      @default(0)
  lastHeartbeat  DateTime @default(now())
  quoteStalenessMs Int    @default(0)

  @@map("broker_connections")
}

model TradingAccount {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  brokerId         String
  broker           Broker   @relation(fields: [brokerId], references: [id])
  accountNumber    String
  currency         String   @default("USD")
  balance          Float
  equity           Float
  marginUsed       Float    @default(0)
  freeMargin       Float    @default(0)
  protectedCapital Float
  profitCapital    Float    @default(0)
  workingCapital   Float
  highWaterMark    Float
  profitFloor      Float    @default(0)
  floatingPL       Float    @default(0)
  dailyPL          Float    @default(0)
  weeklyPL         Float    @default(0)
  monthlyPL        Float    @default(0)
  profitCapitalMode Boolean @default(false)
  positions        Position[]
  capitalLedgers   CapitalLedger[]
  drawdownEvents   DrawdownEvent[]

  @@map("accounts")
}

// ============ INSTRUMENTS ============

model Instrument {
  id           String  @id @default(cuid())
  symbol       String  @unique
  name         String
  assetClass   String  // forex | metals | indices | energies | crypto | stocks | commodities
  baseCurrency String?
  quoteCurrency String?
  currentPrice Float   @default(0)
  dailyChangePct Float @default(0)
  // ---- India market extensions (NSE / BSE / MCX) ----
  exchange     String  @default("GLOBAL") // GLOBAL | NSE | BSE | MCX
  segment      String? // equity | index | future | option | commodity
  country      String  @default("GLOBAL") // GLOBAL | IN
  isin         String?
  lotSize      Int?    // units per derivative lot (Indian F&O / MCX)
  priceBandPct Float?  // Indian circuit-limit price band (%)
  spec         InstrumentSpecification?
  positions    Position[]
  candidates   TradeCandidate[]

  @@map("instruments")
}

model InstrumentSpecification {
  id               String     @id @default(cuid())
  instrumentId     String     @unique
  instrument       Instrument @relation(fields: [instrumentId], references: [id])
  contractSize     Float      @default(100000)
  tickSize         Float      @default(0.00001)
  tickValue        Float      @default(1)
  pipValuePerLot   Float      @default(10)
  minLot           Float      @default(0.01)
  lotStep           Float     @default(0.01)
  maxLot           Float      @default(100)
  marginPerLot     Float      @default(1000)
  typicalSpreadPips Float     @default(1.0)
  currentSpreadPips Float     @default(1.0)

  @@map("instrument_specifications")
}

// ============ INDIA MARKET API HUB (NSE / BSE / MCX) ============

model IndiaApiProvider {
  id             String    @id @default(cuid())
  key            String    @unique // zerodha_kite | upstox | angel_one | dhan | fyers | icici_breeze | oanda | alpaca | binance | …
  markets        String    @default("india") // comma list of Market.key this provider serves
  name           String
  vendor         String
  docsUrl        String
  baseUrl        String
  authType       String    // api_key_secret_daily_token | oauth2 | totp_login | static_token
  authNote       String?
  exchanges      String    // comma list: NSE,BSE,MCX,NFO,BFO
  capabilities   String    // comma list: quotes,historical,websocket,orders,portfolio,margins
  rateLimitNote  String?
  pricingNote    String?
  links          String?   // JSON array of { label, url } — testnet portals, guides, test-fund pages
  status         String    @default("not_configured") // not_configured | configured | connected | error
  isPrimaryData  Boolean   @default(false)
  isPrimaryExec  Boolean   @default(false)
  apiKey         String?
  apiSecret      String?
  accessToken    String?
  tokenExpiresAt DateTime?
  clientCode     String?   // Angel One client code / Dhan client id etc.
  permissionTier String?   // read_only | analysis | trading — connect wizard (spec §6–7)
  consentVersion String?   // API disclaimer version acknowledged
  consentAt      DateTime?
  lastCheckedAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("india_api_providers")
}

model ExchangeSession {
  id           String  @id @default(cuid())
  exchange     String  // NSE | BSE | MCX
  segment      String  // equity | derivatives | commodity
  timezone     String  @default("Asia/Kolkata")
  preOpen      String? // "09:00"
  open         String  // "09:15"
  close        String  // "15:30"
  postClose    String? // "16:00"
  eveningClose String? // MCX non-agri extended close, e.g. "23:30"
  note         String?

  @@unique([exchange, segment])
  @@map("exchange_sessions")
}

model IndiaHoliday {
  id       String   @id @default(cuid())
  exchange String   // NSE | BSE | MCX | ALL
  date     DateTime
  name     String

  @@map("india_market_holidays")
}

// ============ PERMISSIONS, RISK, CONSENT ============

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String
  granted     Boolean  @default(false)
  category    String   // trading | management | hedging | learning | emergency
  updatedAt   DateTime @updatedAt

  @@map("permissions")
}

model RiskProfile {
  id                    String  @id @default(cuid())
  name                  String
  isActive              Boolean @default(false)
  baseLot               Float   @default(0.01)
  maxAggregateExposure  Float   @default(0.05)
  maxRiskPerTradePct    Float   @default(0.5)
  riskCeilingPct        Float   @default(5.0)
  dailyLossLimitPct     Float   @default(2.0)
  weeklyLossLimitPct    Float   @default(5.0)
  maxDrawdownPct        Float   @default(8.0)
  maxMarginUtilPct      Float   @default(25.0)
  maxOpenPositions      Int     @default(4)
  pauseAfterConsecutiveLosses Int @default(3)
  hedgePermitted        Boolean @default(true)
  newsBehavior          String  @default("pause_before_high_impact")
  allowedSessions       String  @default("London,New York")
  allowedAssetClasses   String  @default("forex,metals,indices")

  @@map("risk_profiles")
}

model RiskOverride {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  parameter      String
  previousValue  String
  newValue       String
  duration       String   // one_order | one_strategy | one_instrument | one_session | until_time | persistent
  expiresAt      DateTime?
  scenarioText   String?
  acknowledged   Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("risk_overrides")
}

model ConsentLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // arm_emil | disarm | lot_override | mode_change | close_all | emergency_stop
  mode        String?
  detail      String
  checkboxes  String?  // JSON array of acknowledged items
  authMethod  String   @default("press_and_hold")
  createdAt   DateTime @default(now())

  @@map("consent_logs")
}

// ============ MARKET STATE ============

model MarketRegime {
  id         String   @id @default(cuid())
  symbol     String
  timeframe  String
  regime     String   // strong_bullish_trend, range, compression, breakout, etc.
  confidence Float
  volatilityClass String @default("normal") // normal | elevated | high | extreme | disorderly
  detectedAt DateTime @default(now())

  @@map("market_regimes")
}

model CorrelationSnapshot {
  id        String   @id @default(cuid())
  symbolA   String
  symbolB   String
  window    String   @default("20d")
  coefficient Float
  cluster   String?
  takenAt   DateTime @default(now())

  @@map("correlation_snapshots")
}

model PortfolioExposure {
  id            String   @id @default(cuid())
  dimension     String   // instrument | asset_class | currency | cluster
  key           String
  exposureLots  Float
  exposurePct   Float
  direction     String   @default("net_long")
  updatedAt     DateTime @updatedAt

  @@map("portfolio_exposure")
}

// ============ STRATEGIES ============

model StrategyVersion {
  id             String  @id @default(cuid())
  name           String
  version        String
  strategyType   String  // trend | breakout | mean_reversion | momentum | scalping | swing
  status         String  @default("healthy") // healthy | watch | degraded | suspended | research_only
  healthScore    Float   @default(75)
  trades         Int     @default(0)
  winRate        Float   @default(0)
  avgWin         Float   @default(0)
  avgLoss        Float   @default(0)
  expectancy     Float   @default(0)
  profitFactor   Float   @default(0)
  maxDrawdownPct Float   @default(0)
  sharpeLike     Float   @default(0)
  sortinoLike    Float   @default(0)
  recoveryFactor Float   @default(0)
  consecutiveLosses Int  @default(0)
  driftStatus    String  @default("stable") // stable | drifting | drift_alert
  isChampion     Boolean @default(false)
  isChallenger   Boolean @default(false)
  stage          String  @default("production") // research | backtest | paper | restricted_live | production
  regimePerformance String? // JSON
  candidates     TradeCandidate[]

  @@map("strategy_versions")
}

// ============ AGENTS & DECISIONS ============

model Agent {
  id          String  @id @default(cuid())
  number      Int     @unique
  name        String
  category    String  // market_analysis | strategy | risk | execution | learning | knowledge | guardian
  status      String  @default("active") // active | degraded | offline
  description String
  currentAssessment String?
  confidence  Float   @default(0)
  votes       AgentVote[]

  @@map("agents")
}

model TradeCandidate {
  id              String   @id @default(cuid())
  instrumentId    String
  instrument      Instrument @relation(fields: [instrumentId], references: [id])
  strategyId      String
  strategy        StrategyVersion @relation(fields: [strategyId], references: [id])
  direction       String   // BUY | SELL
  regime          String
  htfBias         String
  entry           Float
  stopLoss        Float
  tp1             Float?
  tp2             Float?
  tp3             Float?
  baseLot         Float    @default(0.01)
  calculatedLot   Float
  maxExposure     Float    @default(0.05)
  aggExposureBefore Float
  aggExposureAfter  Float
  monetaryRisk    Float
  riskPct         Float
  rewardRisk      Float
  confidence      Float
  probabilityScenario String?
  expectedDuration String?
  trendCondition  String?
  volatilityCondition String?
  liquidityCondition String?
  spreadPips      Float?
  estSlippagePips Float?
  newsRisk        String?
  correlationExposure String?
  hedgeRequired   Boolean  @default(false)
  reasonsFor      String   // JSON array
  reasonsAgainst  String   // JSON array
  invalidation    String?
  exitPlan        String?
  guardianStatus  String   @default("pending") // approved | rejected | pending | conditional
  finalDecision   String   @default("WAIT") // BUY SELL WAIT REJECT HEDGE REDUCE CLOSE PAUSE
  consensusScore  Float    @default(0)
  trustScore      Float    @default(0)
  survivalResult  String?  // JSON of catastrophe sim
  status          String   @default("proposed") // proposed | approved | rejected | executed | expired
  pipelineStage   String   @default("agent_council")
  createdAt       DateTime @default(now())
  votes           AgentVote[]
  riskDecisions   RiskDecision[]
  orders          TradeOrder[]

  @@map("trade_candidates")
}

model AgentVote {
  id           String   @id @default(cuid())
  candidateId  String
  candidate    TradeCandidate @relation(fields: [candidateId], references: [id])
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  vote         String   // BUY SELL WAIT REJECT HEDGE REDUCE CLOSE PAUSE
  confidence   Float
  evidenceFor  String?
  evidenceAgainst String?
  createdAt    DateTime @default(now())

  @@map("agent_votes")
}

model RiskDecision {
  id           String   @id @default(cuid())
  candidateId  String
  candidate    TradeCandidate @relation(fields: [candidateId], references: [id])
  engine       String   // independent_risk_engine | guardian | capital_protection | permission_engine
  decision     String   // approved | rejected | conditional
  reason       String
  createdAt    DateTime @default(now())

  @@map("risk_decisions")
}

// ============ ORDERS, EXECUTIONS, POSITIONS ============

model TradeOrder {
  id            String   @id @default(cuid())
  candidateId   String?
  candidate     TradeCandidate? @relation(fields: [candidateId], references: [id])
  symbol        String
  direction     String
  orderType     String   @default("market")
  lots          Float
  price         Float
  stopLoss      Float?
  takeProfit    Float?
  status        String   @default("pending") // pending | filled | cancelled | rejected
  idempotencyKey String  @unique @default(cuid())
  createdAt     DateTime @default(now())
  executions    Execution[]

  @@map("trade_orders")
}

model Execution {
  id          String   @id @default(cuid())
  orderId     String
  order       TradeOrder @relation(fields: [orderId], references: [id])
  fillPrice   Float
  fillLots    Float
  slippagePips Float   @default(0)
  commission  Float    @default(0)
  executedAt  DateTime @default(now())

  @@map("executions")
}

model Position {
  id           String   @id @default(cuid())
  accountId    String
  account      TradingAccount @relation(fields: [accountId], references: [id])
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  direction    String
  lots         Float
  entryPrice   Float
  currentPrice Float
  stopLoss     Float?
  takeProfit   Float?
  floatingPL   Float    @default(0)
  status       String   @default("open") // open | pending | closed
  isHedge      Boolean  @default(false)
  strategyName String?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  closedPL     Float?
  hedges       Hedge[]

  @@map("positions")
}

model Hedge {
  id             String   @id @default(cuid())
  positionId     String
  position       Position @relation(fields: [positionId], references: [id])
  hedgeSymbol    String
  hedgeLots      Float
  reason         String
  exitCondition  String
  status         String   @default("active") // active | removed
  openedAt       DateTime @default(now())
  removedAt      DateTime?

  @@map("hedges")
}

// ============ CAPITAL & DRAWDOWN ============

model CapitalLedger {
  id          String   @id @default(cuid())
  accountId   String
  account     TradingAccount @relation(fields: [accountId], references: [id])
  entryType   String   // deposit | realized_pl | profit_lock | hwm_update | milestone
  amount      Float
  balanceAfter Float
  equityAfter Float
  note        String?
  createdAt   DateTime @default(now())

  @@map("capital_ledgers")
}

model DrawdownEvent {
  id           String   @id @default(cuid())
  accountId    String
  account      TradingAccount @relation(fields: [accountId], references: [id])
  level        String   // daily | weekly | monthly | hwm | strategy | asset_class | floating
  drawdownPct  Float
  thresholdPct Float
  action       String
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("drawdown_events")
}

// ============ LEARNING & KNOWLEDGE ============

model LearningEvent {
  id          String   @id @default(cuid())
  eventType   String   // post_trade_analysis | correction | drift_detected | regime_learned | promotion | correct_loss | bad_loss
  title       String
  detail      String
  agentName   String?
  createdAt   DateTime @default(now())

  @@map("learning_events")
}

model KnowledgeItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  title          String
  knowledgeType  String   // strategy | indicator | ea | journal | document | screenshot | dataset | correction | instruction | url
  classification String   @default("personal") // personal | global
  factType       String   @default("hypothesis") // fact | opinion | hypothesis
  trustLevel     Int      @default(0) // 0-7
  sourceReliability String @default("unverified")
  scopeNote      String?
  contentText    String?
  cloudStoragePath String?
  isPublic       Boolean  @default(false)
  fileName       String?
  fileType       String?
  status         String   @default("processing") // processing | parsed | understood | validated | active | retired
  analysisResult String?  // LLM analysis JSON/text
  tags           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("knowledge_items")
}

// ============ SYSTEM ============

model EmilState {
  id                 String   @id @default(cuid())
  armed              Boolean  @default(false)
  mode               String   @default("observation") // observation | advisory | confirmation | assisted | semi_autonomous | autonomous | management_only | capital_protection | emergency
  guardianStatus     String   @default("active")
  guardianDecision   String   @default("NORMAL OPERATION")
  trustScore         Float    @default(62)
  trustBreakdown     String?  // JSON
  agentConsensus     String   @default("WAIT")
  consensusScore     Float    @default(0)
  volatilityStatus   String   @default("normal")
  newsCountdownMins  Int      @default(999)
  nextNewsEvent      String?
  marketDataHealth   String   @default("healthy")
  updatedAt          DateTime @updatedAt

  @@map("emil_state")
}

model EmergencyEvent {
  id          String   @id @default(cuid())
  eventType   String   // emergency_stop | close_all | kill_switch | broker_outage
  triggeredBy String
  detail      String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("emergency_events")
}

model SystemHealth {
  id           String   @id @default(cuid())
  component    String
  status       String   @default("healthy") // healthy | degraded | down
  latencyMs    Int      @default(0)
  message      String?
  checkedAt    DateTime @default(now())

  @@map("system_health")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  actor     String   @default("user") // user | emil | guardian | system
  action    String
  category  String   @default("general")
  detail    String
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ============ TEACH EMIL — RESEARCH INTELLIGENCE SYSTEM ============
// Ingest → attribute → understand → question → structure → test → challenge →
// validate → remember → hypothesize → retest → monitor → evolve.
// Nothing learned is believed; every claim starts as a hypothesis.

model ResearchSource {
  id            String    @id @default(cuid())
  submittedById String?
  sourceType    String    @default("article") // youtube | article | document | dataset | manual
  url           String?
  title         String
  author        String?   // channel / presenter / publisher
  publishedAt   DateTime?
  durationSec   Int?
  metadata      String?   // JSON: oEmbed, chapters, page counts, etc.
  extractedText String?   // transcript / article text (capped)
  status        String    @default("queued") // queued | fetching | fetched | analyzing | analyzed | quarantined | error
  reliability   String    @default("unrated") // unrated | low | medium | high | flagged
  fetchError    String?
  claimCount    Int       @default(0)
  analysisJson  String?   // full extraction result JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  claims        KnowledgeClaim[]

  @@map("research_sources")
}

model KnowledgeConcept {
  id                String    @id @default(cuid())
  name              String    @unique
  category          String    @default("other") // indicator | strategy | macro | instrument | regime | risk | psychology | session | event | central_bank | correlation | other
  summary           String?
  instruments       String?   // comma list
  timeframes        String?   // comma list
  regimes           String?   // comma list
  validationStatus  String    @default("untested") // untested | testing | supported | weak | rejected | regime_dependent
  confidence        Float     @default(20) // 0-100, evidence-based, never popularity-based
  confidenceFactors String?   // JSON breakdown of +/- factors
  sourceCount       Int       @default(0)
  lastTestedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  claims            KnowledgeClaim[]
  edgesFrom         KnowledgeEdge[] @relation("EdgeFrom")
  edgesTo           KnowledgeEdge[] @relation("EdgeTo")

  @@map("knowledge_concepts")
}

model KnowledgeClaim {
  id               String    @id @default(cuid())
  sourceId         String
  source           ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  conceptId        String?
  concept          KnowledgeConcept? @relation(fields: [conceptId], references: [id])
  claimText        String
  claimType        String    @default("hypothesis") // fact | opinion | prediction | trading_rule | performance_claim | psychology | hypothesis
  instrument       String?
  timeframe        String?
  regime           String?
  locationHint     String?   // video timestamp / page number
  evidenceText     String?   // evidence supplied BY the source (not EMIL's validation)
  validationStatus String    @default("untested") // untested | testing | supported | weak | rejected | regime_dependent
  confidence       Float     @default(20)
  lastTestedAt     DateTime?
  createdAt        DateTime  @default(now())

  @@map("knowledge_claims")
}

model KnowledgeEdge {
  id        String   @id @default(cuid())
  fromId    String
  from      KnowledgeConcept @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        KnowledgeConcept @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  relation  String   // drives | inverse | correlates | filters | component_of | contradicts | precedes | regime_of
  strength  Float    @default(0.5)
  note      String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId, relation])
  @@map("knowledge_edges")
}

model ResearchHypothesis {
  id           String   @id @default(cuid())
  title        String
  statement    String
  originType   String   @default("source_claim") // source_claim | emil_generated | contradiction_probe | admin
  sourceId     String?
  conceptNames String?  // comma list
  status       String   @default("proposed") // proposed | researching | testing | supported | weak | rejected | regime_dependent
  confidence   Float    @default(20)
  testPlan     String?
  findings     String?
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("research_hypotheses")
}

model KnowledgeContradiction {
  id             String   @id @default(cuid())
  topic          String
  sideA          String
  sideB          String
  sourceAId      String?
  sourceBId      String?
  analysisNote   String?  // WHEN does each side work (regime/timeframe/instrument)?
  status         String   @default("open") // open | investigating | resolved_regime | resolved_timeframe | resolved_instrument | rejected_a | rejected_b | unresolved
  resolutionNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("knowledge_contradictions")
}

model StrategyBlueprint {
  id                String   @id @default(cuid())
  code              String   // EMIL-FX-001, EMIL-EQ-002, ...
  version           String   @default("1.0")
  name              String
  origin            String   @default("extracted") // extracted | emil_generated
  sourceId          String?
  market            String?  // forex | equities | indices | commodities | metals | energy | bonds | etf | futures | crypto | multi
  instruments       String?
  timeframe         String?
  indicators        String?  // JSON array
  entryLong         String?
  entryShort        String?
  stopLoss          String?
  takeProfit        String?
  positionSizing    String?
  filters           String?
  invalidConditions String?
  completeness      String   @default("incomplete") // complete | incomplete — never invent missing rules
  missingFields     String?
  state             String   @default("LEARNED") // LEARNED | UNVERIFIED | RESEARCHING | BACKTESTED | REJECTED | PAPER_TRADING | HUMAN_APPROVED | LIVE_ELIGIBLE
  labStage          String   @default("idea") // idea | rules | data_validation | backtest | out_of_sample | walk_forward | stress | regime | risk | score | paper | human_review
  robustnessScore   Float    @default(0)
  metrics           String?  // JSON latest metrics
  regimeNotes       String?  // JSON: where it works / where it fails
  changeLog         String?  // JSON array — full research lineage, never silently rewritten
  isCurrent         Boolean  @default(true)
  approvedBy        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  labRuns           LabRun[]

  @@unique([code, version])
  @@map("strategy_blueprints")
}

model LabRun {
  id          String   @id @default(cuid())
  blueprintId String
  blueprint   StrategyBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  runType     String   // data_validation | backtest | out_of_sample | walk_forward | stress | monte_carlo | regime | risk | score | paper
  dataMode    String   @default("estimated") // estimated (LLM research estimate) | historical (real data engine)
  status      String   @default("completed") // running | completed | failed
  params      String?  // JSON
  metrics     String?  // JSON
  verdict     String?  // pass | weak | fail
  notes       String?
  createdAt   DateTime @default(now())

  @@map("lab_runs")
}

model ResearchNote {
  id        String   @id @default(cuid())
  title     String
  studied   String?
  learned   String?
  stats     String?  // JSON counts: sources/claims/concepts/contradictions/hypotheses/strategies
  content   String?  // markdown body
  createdAt DateTime @default(now())

  @@map("research_notebook")
}

model ConfidenceEvent {
  id         String   @id @default(cuid())
  targetType String   // concept | claim | hypothesis | strategy
  targetId   String
  targetName String?
  previous   Float
  next       Float
  reason     String
  actor      String   @default("emil") // emil | admin
  createdAt  DateTime @default(now())

  @@map("confidence_events")
}

// ---- Alert & Notification Center (spec §37, §65) ------------------------
// Price alerts are set on watchlist symbols only, so alert evaluation rides
// the same cached watchlist quotes and never spends extra data-plan credits.
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String
  condition   String    // above | below
  threshold   Float
  status      String    @default("active") // active | triggered | disabled
  note        String?
  lastPrice   Float?
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@map("price_alerts")
}

// In-app notification center. Delivery is in-app only today (email/push are
// future channels — never claim otherwise in the UI).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // price_alert | system | risk | broker | admin
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

// ---- Feature flags (spec §77) -------------------------------------------
// High-risk modules ship behind admin-controlled flags. Reads are cached
// briefly in-process; flips take effect within ~30s without a deploy.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ============ VENUE EXECUTION (paper + live) ============

// Every order EMIL sends to an exchange venue, paper or live, journaled
// before the venue call and updated after it. Separate from trade_orders
// (the agent pipeline's simulated orders) on purpose: paper ≠ live ≠ demo.
model VenueOrder {
  id            String   @id @default(cuid())
  userId        String
  providerKey   String   // india_api_providers.key (deribit_testnet, gemini_sandbox, …)
  paper         Boolean  @default(true)
  symbol        String
  side          String   // buy | sell
  orderType     String   // market | limit
  qty           Float
  price         Float?
  notionalUsd   Float?
  venueOrderId  String?
  status        String   @default("submitted") // submitted | open | partially_filled | filled | cancelled | rejected | error
  filledQty     Float    @default(0)
  avgFillPrice  Float?
  message       String?
  raw           String?
  clientOrderId String   @unique @default(cuid())
  // Execution protections (spec §61–62)
  refPrice       Float?
  slippageBps    Float?
  quoteLatencyMs Int?
  guardNotes     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, providerKey, createdAt])
  @@map("venue_orders")
}

// ============ TRADE JOURNAL (spec §35–36) ============

model JournalEntry {
  id           String    @id @default(cuid())
  userId       String
  sourceType   String    @default("manual") // venue_order | trade_order | manual
  sourceId     String?
  symbol       String
  side         String?   // buy | sell
  qty          Float?
  entryPrice   Float?
  exitPrice    Float?
  pnl          Float?
  notes        String?
  tags         String?   // csv
  setup        String?
  mistakes     String?   // csv
  aiReview     String?   // JSON from the post-trade review
  aiReviewedAt DateTime?
  tradedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@map("journal_entries")
}

// ============ RATE LIMITING ============

// Fixed-window counters shared across serverless instances (lib/rate-limit).
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("rate_limits")
}

// Admin-managed demo environment (spec §50–51). Credentials live on the demo
// User row (bcrypt); this single row tracks who reset what, when.
model DemoEnvironment {
  id            String    @id
  demoEmail     String
  demoUserId    String?
  passwordSetAt DateTime?
  lastResetAt   DateTime?
  lastResetBy   String?
  resetCount    Int       @default(0)
  note          String?
  updatedAt     DateTime  @default(now()) @updatedAt

  @@map("demo_environment")
}

// Instrument master (spec §150–151) — synced from lib/instruments/catalog.ts.
model InstrumentMaster {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  assetClass      String
  market          String
  exchange        String
  country         String
  currency        String
  base            String?
  quote           String?
  tdSymbol        String?
  tdProxy         Boolean  @default(false)
  tvSymbol        String?
  emilTradeSymbol String?
  deribitSymbol   String?
  geminiSymbol    String?
  deltaSymbol     String?
  aliases         String   @default("")
  lotSize         Int?
  tickSize        Float?
  dataStatus      String   @default("live")
  tradable        Boolean  @default(false)
  catalogVersion  Int      @default(1)
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([market])
  @@index([assetClass])
  @@map("instrument_master")
}

// Charting persistence (spec §14, §253): saved layouts + per-symbol price levels.
model ChartLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  config    String   // JSON: symbol, interval, chartType, sma, ema, rsi, bb, compare
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("chart_layouts")
}

model ChartLevel {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  price     Float
  label     String?
  color     String   @default("#f59e0b")
  createdAt DateTime @default(now())

  @@index([userId, symbol])
  @@map("chart_levels")
}
