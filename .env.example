# EMIL Control Cockpit — environment
# Supabase Postgres (project jnjxudsjyrftehwwdufs). Use the session pooler URL
# from Supabase Dashboard → Connect, and paste the database password:
DATABASE_URL="postgresql://postgres.jnjxudsjyrftehwwdufs:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Any long random string
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# AI engine (Abacus chat-completions) — powers Explain, Knowledge Council,
# Teach EMIL / Ask EMIL and the Strategy Lab. Without it those features return
# an honest "AI engine not configured" error instead of failing opaquely.
ABACUSAI_API_KEY=

# Optional: S3-compatible storage for Teach-EMIL file uploads (leave empty to disable)
AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# Encryption at rest for broker / provider credentials (spec §11).
# 32 random bytes, base64 — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it credentials are stored in plaintext (a warning is logged once).
# Changing it makes previously encrypted rows unreadable — rotate deliberately.
EMIL_SECRETS_KEY=

# Guarded order router — per-order notional caps in USD (defaults shown)
EMIL_PAPER_MAX_NOTIONAL_USD=25000
EMIL_LIVE_MAX_NOTIONAL_USD=1000
